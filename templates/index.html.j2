<!DOCTYPE html>
<html>
<head>
    <title>{{ app_name }}</title>
</head>
<body>
    <h1>{{ app_name }}</h1>

    <p>Server: {{ inventory_hostname }}</p>
    <p>Environment: {{ environment | upper }}</p>

    {% if environment == "production" %}
        <p>Production Server</p>
    {% else %}
        <p>Development Server</p>
    {% endif %}
</body>
</html>